# Пример только для Python-версии: любые библиотеки Python как есть
import datetime
import os
import sys

now = datetime.datetime.now()
print("сегодня:", now.strftime("%d.%m.%Y %H:%M:%S"))
print("рабочая папка:", os.getcwd())
print("питон:", sys.version.split()[0], "| платформа:", sys.platform)

# Объекты Python работают напрямую
lines = []
loop i in range(3):
    lines.append("строка " + str(i))
text = "\n".join(lines)
print("многострочный текст:\n" + text)

data = sorted({"б": 2, "а": 1, "в": 3}.items())
print("пары из словаря:", data)
